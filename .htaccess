# RESCUE-1 配車記録 — Xサーバー(Apache) 用設定

# .webmanifest を正しい MIME タイプで配信（PWAインストールに必要）
AddType application/manifest+json .webmanifest

# 文字コード
AddDefaultCharset UTF-8

# Service Worker は毎回最新を確認（アプリ更新がすぐ反映されるように）
<IfModule mod_headers.c>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, max-age=0"
  </FilesMatch>
</IfModule>
